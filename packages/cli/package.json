{
  "name": "@paramfinder/cli",
  "version": "0.1.0",
  "description": "CLI for ParamFinder discovery scans",
  "type": "module",
  "bin": {
    "paramfinder": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@paramfinder/engine": "workspace:*",
    "commander": "^14.0.3"
  }
}
