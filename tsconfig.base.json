{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "customConditions": ["development"],
    "types": ["node"]
  }
}
